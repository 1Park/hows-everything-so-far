# Shared board defaults. No secrets. The application must explicitly load this file.
# Planned deployment: native Ubuntu processes, Python venv, FastAPI + Uvicorn.
# *_HOST/PORT bind servers; *_BASE_URL tells the Controller where to call.
# Board LLM: Gemma on the NPU via scripts/board_llm.sh (QWEN_MODEL_BACKEND=executorch).
APP_ENV=board
# The tablet reaches the Controller over the wired end0 link and the team over
# tailnet, so it must listen on every interface. Keep the venue Wi-Fi out with a
# firewall rule instead: iptables -A INPUT -i wlp3s0 -p tcp --dport 8080 -j DROP
CONTROLLER_HOST=0.0.0.0
CONTROLLER_PORT=8080
VISION_BACKEND=http
VISION_HOST=127.0.0.1
VISION_PORT=8001
VISION_BASE_URL=http://127.0.0.1:8001
QWEN_BACKEND=http
QWEN_HOST=127.0.0.1
QWEN_PORT=8000
QWEN_BASE_URL=http://127.0.0.1:8000
HARDWARE_BACKEND=mock
# Tablet UI/speaker over Ethernet HTTP; microphone capture belongs to the board.
# The Logitech Brio 101 carries both the camera and the microphone. Address it by
# card name, not number: USB cards renumber depending on plug order. plughw lets
# ALSA convert rather than failing on an exact-format mismatch.
# The device offers 16/32/48kHz; record at 16kHz because that is what the STT
# model consumes and the server does not resample.
AUDIO_INPUT=alsa
AUDIO_DEVICE=plughw:CARD=B101,DEV=0
AUDIO_FORMAT=S16_LE
AUDIO_RATE=16000
AUDIO_CHANNELS=1
AUDIO_SECONDS=6
OBSERVE_INTERVAL_SECONDS=0
# Switch to bridge explicitly after MCU and official Bridge package verification.
QWEN_MODEL_BACKEND=executorch
# Actual paths from the track bundle, resolved relative to the repository if not absolute.
QNN_LLAMA_RUNNER=
QNN_RUNNER=
QWEN_MODEL_PATH=
QWEN_TOKENIZER_PATH=
# Set QWEN_SEQ_LEN to a supported TOTAL prompt+output token budget from the bundle.
# QWEN_SEQ_LEN=512
VISION_MODEL_PATH=
QWEN_MODEL=gemma4
VISION_MODEL_BACKEND=fixture
VISION_ADAPTER=
# Required when the real board Vision bundle uses native cli/resident runners.
# Build/deploy this worker before enabling VISION_MODEL_BACKEND=external.
VISION_WORKER_BIN=models/board/bin/qnn_vision_worker
# Refill offer: Vision fill_ratio at or below this. Board Vision reports a cup between the
# low (0.18) and mid (0.5) levels as ~0.3, so 0.3 kept missing nearly-empty glasses (0.303 seen).
LOW_FILL_THRESHOLD=0.35
# Vision confidence = min(drink, level) probability, so a low glass the model splits between
# low and empty (both mean refill) lands near 0.6-0.7; 0.7 skipped a 20% glass at 0.66.
MIN_CONFIDENCE=0.6
# DINOv2 Vision: after placing a board bundle (ml/export/make_bundle.py) switch explicitly to
#   VISION_MODEL_BACKEND=external
#   VISION_ADAPTER=services.vision.backend:create_backend
#   VISION_MODEL_PATH=models/board/vision/<bundle>
#   VISION_RUNNER_BIN=<qnn_executor_runner path>   # only if the bundle uses the cli runner
STT_BACKEND=http
STT_HOST=127.0.0.1
STT_PORT=8002
STT_BASE_URL=http://127.0.0.1:8002
STT_MODEL_BACKEND=external
STT_ADAPTER=services.stt.whisper_http:create_backend
# whisper.cpp server started separately (port 8178), see services/stt/README.md.
STT_WHISPER_URL=http://127.0.0.1:8178
# Logitech Brio 101 on the board's USB port. /dev/video1 is its metadata node
# and does not open; index 0 delivers 640x480 frames.
CAMERA_SOURCE=0
# Raise only as far as the board's load allows; watch the encode loop under htop.
CAMERA_FPS=15
VIDEO_STREAM_FPS=10
# History of controller phase changes for the dashboard (empty disables).
EVENT_LOG_PATH=logs/events.jsonl
