# Copy to .env for personal development. Never add credentials to tracked files.
# These are application settings, not an implemented server launcher.
# Default local startup: Controller/UI only; Vision fixture, remote Mac Qwen.
# *_HOST/PORT are local bind settings, not instructions to launch those servers.
# To integrate a running Vision API: set VISION_BACKEND=http and its BASE_URL.
APP_ENV=development
CONTROLLER_HOST=127.0.0.1
CONTROLLER_PORT=8080
VISION_BACKEND=fixture
VISION_HOST=127.0.0.1
VISION_PORT=8001
VISION_BASE_URL=http://127.0.0.1:8001
QWEN_BACKEND=http
QWEN_HOST=127.0.0.1
QWEN_PORT=8000
QWEN_BASE_URL=http://won-macmini:8000
HARDWARE_BACKEND=mock
