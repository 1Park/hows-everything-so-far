# Copy to .env for personal development. Never add credentials to tracked files.
# Use python scripts/dev.py. Process environment overrides the selected file.
# Default local startup: Controller/UI only; Vision fixture, remote Mac Qwen.
# *_HOST/PORT are local bind settings, not instructions to launch those servers.
# To integrate a running Vision API: set VISION_BACKEND=http and its BASE_URL.
APP_ENV=development
CONTROLLER_HOST=127.0.0.1
CONTROLLER_PORT=8080
VISION_BACKEND=fixture
VISION_HOST=127.0.0.1
VISION_PORT=8001
VISION_BASE_URL=http://127.0.0.1:8001
QWEN_BACKEND=http
QWEN_HOST=127.0.0.1
QWEN_PORT=8000
QWEN_BASE_URL=http://won-macmini:8000
HARDWARE_BACKEND=mock
STT_BACKEND=fixture
STT_HOST=127.0.0.1
STT_PORT=8002
STT_BASE_URL=http://127.0.0.1:8002
STT_MODEL_BACKEND=fixture
STT_ADAPTER=
# Board-owned microphone. Disabled for ordinary desktop development.
AUDIO_INPUT=disabled
AUDIO_DEVICE=
AUDIO_FORMAT=S16_LE
AUDIO_RATE=48000
AUDIO_CHANNELS=1
AUDIO_SECONDS=6
# 0 = observation is triggered by POST /api/observe; >0 = idle/skip polling.
OBSERVE_INTERVAL_SECONDS=0
# Only used by services.stt.whisper_http:create_backend.
STT_WHISPER_URL=http://127.0.0.1:8178
VISION_MODEL_BACKEND=fixture
VISION_ADAPTER=
# DINOv2 backend: VISION_MODEL_BACKEND=external, VISION_ADAPTER=services.vision.backend:create_backend
VISION_MODEL_PATH=
VISION_RUNNER_BIN=
QWEN_MODEL_BACKEND=mlx
QWEN_UPSTREAM_URL=http://won-macmini:8000
QWEN_MODEL=mlx-community/Qwen3-0.6B-4bit
INFERENCE_TIMEOUT=20
QUEUE_LIMIT=4
RESPONSE_TIMEOUT=60
MIN_CONFIDENCE=0.7
LOW_FILL_THRESHOLD=0.3
# Optional capture (install .[camera]): empty=sample, 0=USB index, file path=video loop.
# Ask which drink when Vision reports coke/coffee with item_confidence below this
ITEM_CONFIRM_THRESHOLD=0.8
CAMERA_SOURCE=
