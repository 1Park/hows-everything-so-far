[Unit]
Description=Refill Assist resident TTS API
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/project/hows-everything-so-far
Environment=REFILL_ENV_FILE=%h/project/hows-everything-so-far/.env.board
EnvironmentFile=%h/.config/refill-assist/tts.env
ExecStart=%h/project/hows-everything-so-far/.venv/bin/python -m uvicorn services.tts.server:create_app --factory --host 127.0.0.1 --port 8003
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
KillMode=control-group

[Install]
WantedBy=default.target
